# Copy to .env and fill in. .env is ignored by git; never commit real values.
# See docs/development/setup.md for how to obtain each value.

# --- Local development warehouse (DuckDB) -----------------------------------
# DUCKDB_PATH=data/dev/jobmarket.duckdb

# --- Snowflake ---------------------------------------------------------------
# Account identifier, e.g. abc12345.ap-south-1.aws or orgname-accountname
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
# Key-pair authentication is recommended. Set one of the two options below.
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=JMA_TRANSFORM
SNOWFLAKE_WAREHOUSE=JMA_WH
SNOWFLAKE_DATABASE=JOB_MARKET

# --- Local models (Ollama) -----------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Hosted model APIs ---------------------------------------------------------
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq Cloud: https://console.groq.com/keys
GROQ_API_KEY=
